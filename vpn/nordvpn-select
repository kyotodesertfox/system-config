STATE_FILE = "/var/lib/nordvpn-select/current-state"

# REBALANCING THRESHOLDS
#
# Two conditions, both required, because either one alone misbehaves.
#
# FLOOR - do not consider moving at all until the current server is genuinely
# loaded. NordVPN's "load" is a capacity indicator, not latency: a 5% server
# and a 25% server are indistinguishable in use. Measured across Atlanta's 158
# servers the spread was min 0%, median 10%, p90 16%, max 30% - so on a normal
# day nothing there is congested and the correct action is none.
#
# MARGIN - once loaded, only move if the alternative is in a different class.
# Without this it hops: you move to the 0% server, it climbs to 8% within the
# hour, some other server is now at 0%, and it moves again forever.
#
# A margin alone does not work at any small value. Across 158 servers there is
# almost always something 5 points better than wherever you are, so a margin of
# 5 fires for 82% of servers - it reads restrictive and behaves as "always".
# Only 20+ exceeds the everyday spread (fires for 7 of 158).
#
# THESE NUMBERS ARE REASONED, NOT MEASURED. They come from one snapshot, with
# no data on how load moves across a day or whether the city spikes at peak
# hours. Every poll decision is logged to DECISION_LOG so they can be tuned
# from evidence later instead of from a guess.
#
# Neither threshold affects healing. A server that stops answering, or that
# leaves NordVPN's list, is replaced immediately regardless of load - that is
# the failure that actually breaks things, and it is unconditional.
FLOOR = 45
MARGIN = 20

DECISION_LOG = "/var/log/nordvpn-select.log"


# How long to wait for a real handshake before calling a server dead.
HANDSHAKE_WAIT = 12
HANDSHAKE_FRESH = 180

