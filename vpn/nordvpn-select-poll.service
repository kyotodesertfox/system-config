[Unit]
Description=NordVPN health check - heal a dead server, rebalance only if genuinely congested
Documentation=file:///usr/local/sbin/nordvpn-select
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nordvpn-select --poll

# Refresh the kill switch's API address set while the tunnel is healthy. The
# addresses are Cloudflare's and they rotate; if the set goes stale, recovery
# from a retired server is impossible at the moment it is needed. The refresh
# refuses to run when traffic is not routing through the tunnel, so it can
# never cache an answer obtained outside it.
ExecStartPost=-/usr/local/sbin/nordvpn-api-refresh

# A poll that hangs must not stack up behind the next one.
TimeoutStartSec=180

# It needs root for `wg set` and the netplan source, and network for the API.
# Nothing else, so take away what it does not use.
PrivateTmp=true
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictRealtime=true
NoNewPrivileges=true

# Exit 1 means "nothing to do" - staying put, no state recorded, API
# unreachable. That is a normal outcome, not a failure, and must not show as
# a failed unit or it trains you to ignore the status.
SuccessExitStatus=0 1
